{
  "name": "sweep-ui",
  "version": "1.0.0",
  "description": "The list Issue Sweep, PR Sweep, and Review Sweep draw each tab with: summary squares, rows ordered Now, Next, and Later, and a stage track.",
  "bb": {
    "pluginTailwindContent": [
      "*.tsx",
      "!*.test.tsx",
      "!*.stories.tsx"
    ]
  },
  "private": true,
  "type": "module",
  "exports": {
    "./list": "./list.tsx",
    "./row": "./row.tsx",
    "./track": "./track.tsx",
    "./summary": "./summary.tsx",
    "./note": "./note.tsx",
    "./banner": "./banner.tsx",
    "./pull-request": "./pull-request.tsx",
    "./sidebar-count": "./sidebar-count.tsx",
    "./actions": "./actions.tsx",
    "./types": "./types.ts"
  },
  "peerDependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
