{
  "name": "bb-plugins",
  "private": true,
  "description": "Workspace root for the whole checkout. Every plugin and shared library is a workspace with its own package.json; they share one lockfile and one node_modules here. Playwright, for the story screenshots, is the root's own dependency.",
  "workspaces": [
    "bb-plugin-automation-palette",
    "bb-plugin-contributor-dashboard",
    "bb-plugin-diff-comment",
    "bb-plugin-diff-viewed",
    "bb-plugin-gh-context",
    "bb-plugin-hacks",
    "bb-plugin-harvest",
    "bb-plugin-impromptu-ui",
    "bb-plugin-issue-sweep",
    "bb-plugin-markdown-editor",
    "bb-plugin-new-issue",
    "bb-plugin-now",
    "bb-plugin-plugin-shelf",
    "bb-plugin-pr-sweep",
    "bb-plugin-presentations",
    "bb-plugin-review-sweep",
    "bb-plugin-super-diff",
    "bb-plugin-super-diff-v1",
    "bb-plugin-thread-overview",
    "bb-plugin-thread-todos",
    "bb-plugin-tokenomics",
    "bb-plugin-weekly-review",
    "component-library",
    "gh-shared",
    "sweep-ui"
  ],
  "scripts": {
    "postinstall": "node scripts/link-workspace-deps.mjs",
    "storybook": "node scripts/ladle.mjs serve",
    "storybook:build": "node scripts/ladle.mjs build",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:commit": "node scripts/screenshots.mjs --commit",
    "screenshots:isolated": "node scripts/screenshots.mjs --isolated"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
