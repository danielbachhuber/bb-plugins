{
  "name": "bb-plugin-diff-viewed",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.4.34"
  },
  "bb": {
    "name": "Diff Viewed",
    "description": "Adds a Viewed checkbox to each file in the changes panel, so a reviewed file collapses, dims, and stays that way until its diff changes, with a count of files viewed so far, an Only unviewed filter that hides reviewed files, and two-way sync with GitHub's Viewed boxes on the thread's pull request, which marks a file viewed on GitHub once you push the diff you marked in bb.",
    "branding": {
      "icon": "CircleCheck"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@danielb/gh-shared": "file:../gh-shared",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.31",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "typescript": "^5.7.0",
    "@pierre/diffs": "^1.5.2",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-menubar": "^1.1.25",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "@testing-library/dom": "^10.4.2",
    "jsdom": "^30.1.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
