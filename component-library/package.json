{
  "name": "component-library",
  "version": "1.0.0",
  "description": "UI that several plugins draw the same way, starting with the sync status in a page's title bar.",
  "bb": {
    "pluginTailwindContent": [
      "**/*.tsx",
      "!**/*.test.tsx",
      "!**/*.stories.tsx",
      "!node_modules/**"
    ]
  },
  "private": true,
  "type": "module",
  "exports": {
    "./sync-status": "./sync-status/sync-status.tsx",
    "./sidebar-count": "./sidebar-count/sidebar-count.tsx",
    "./segmented": "./segmented/segmented.tsx"
  },
  "peerDependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
