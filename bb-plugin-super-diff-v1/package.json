{
  "name": "bb-plugin-super-diff-v1",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.47",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Super Diff v1",
    "description": "Review a branch one concern at a time. A panel beside the thread groups every hunk on the branch into concerns, each with a summary written by the thread's agent, checks that every hunk appears exactly once and that bb lists the same files, lets you check off each hunk, kept in step with GitHub's per-file Viewed or, with no pull request, Diff Viewed's, shows test changes as Gherkin scenarios with what they leave out, and shows exactly what changed when the branch moves on.",
    "branding": {
      "icon": "Layers"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "bbPlugins": {
    "status": "retired",
    "note": "An exploration of grouping hunks into concerns, kept for reference. Replaced by bb-plugin-super-diff."
  },
  "dependencies": {
    "@danielb/gh-shared": "file:../gh-shared",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@pierre/diffs": "^1.6.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "hono": "^4.13.8",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs"
  }
}
