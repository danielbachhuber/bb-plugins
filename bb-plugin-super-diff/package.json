    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@danielbachhuber/bb-plugin-component-library": "^1.5.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
